# Baseline for new C++ projects. Start broad, then remove noisy check families
# deliberately instead of turning clang-tidy off as a whole.
Checks: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: ''
# Narrow this to project headers so third-party includes are not analyzed.
HeaderFilterRegex: '^(src|include)/'
FormatStyle: file
